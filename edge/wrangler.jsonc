{
  // Keron relay (a fork of Zeron's edge): per-chat and per-workspace sync
  // DOs, per-device relay DOs, R2 blobs, and the WorkOS auth routes.
  // Design: loro-sessions §2 (topology), §3 (persistence), §6.1 (diff
  // sidecar), §8 (device-room streams), §1.2 (R2 attachments), §3.3 (R2
  // backups); ARCHITECTURE.md §6.
  //
  // Every "change-me" value is the owner's to fill in; edge/RELAY.md has the
  // steps. WORKOS_CLIENT_ID, APNS_TEAM_ID, APNS_TOPIC and the route's host
  // must match the app root's keron.toml:
  //   cargo run -p keron-config --features cli -- check
  //
  // Durable Object storage is bound to the worker name: once deployed, never
  // rename "keron-edge", or every chat and registry room is orphaned.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed by hand (`npx wrangler deploy`, see RELAY.md);
  // .github/workflows/deploy.yml can also deploy it on demand.
  "name": "keron-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Cloudflare dashboard → Workers & Pages → Account ID.
  "account_id": "change-me",
  // Only the custom domain below serves the relay; no *.workers.dev URL.
  "workers_dev": false,
  // The relay's hostname on a zone in the same Cloudflare account. It must
  // equal keron.toml's relay.host. Cloudflare creates the DNS record and the
  // certificate on deploy.
  "routes": [
    { "pattern": "relay.change-me.invalid", "custom_domain": true }
  ],
  // Serve src/install.sh as a string (the /install.sh route).
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  // loro-crdt's default entry loads its WASM via URL fetch, which workerd
  // cannot do at runtime; the base64 entry inlines the module instead.
  "alias": {
    "loro-crdt": "loro-crdt/base64"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOMS", "class_name": "SessionRoom" },
      { "name": "DEVICE_ROOMS", "class_name": "DeviceRoom" },
      { "name": "PREVIEW_ROOMS", "class_name": "PreviewRoom" },
      { "name": "REGISTRY_ROOMS", "class_name": "RegistryRoom" },
      { "name": "CHAT_ROOMS", "class_name": "ChatRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom", "DeviceRoom"]
    },
    {
      // Workspace registry (docs/registry-sync.md) — the row-table sidebar
      // sync that replaces the Loro workspace doc rooms.
      "tag": "v2",
      "new_sqlite_classes": ["RegistryRoom"]
    },
    {
      // chat2 session rooms (docs/chat2-sync.md) — dumb log relays that
      // replace SessionRoom's loro-aware s2 rooms.
      "tag": "v3",
      "new_sqlite_classes": ["ChatRoom"]
    },
    { "tag": "v4", "new_sqlite_classes": ["PreviewRoom"] }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "keron-blobs"
    },
    {
      // Release artifacts for /releases/*. Empty unless you publish builds
      // there and turn on keron.toml's updates.enabled.
      "binding": "RELEASES",
      "bucket_name": "keron-releases"
    }
  ],
  "vars": {
    // WorkOS AuthKit client id of the relay's own AuthKit app (keron.toml
    // relay.workos_client_id); JWTs are verified against its JWKS.
    "WORKOS_CLIENT_ID": "client_change-me",
    // Always "workos" here. "dev" accepts any bearer without verifying it:
    // only ever pass it to a local `wrangler dev` (npm run dev does).
    "AUTH_MODE": "workos",
    // Push notifications: your Apple team id (keron.toml apple.team_id) and
    // the iPhone app's bundle id, <bundle_prefix>.keron.ios.
    "APNS_TEAM_ID": "CHANGE-ME",
    "APNS_TOPIC": "invalid.change-me.keron.ios"
    // Secrets, set with `npx wrangler secret put <NAME>` (RELAY.md):
    //   WORKOS_API_KEY  the AuthKit app's API key; unset ⇒ /auth/* answers 501
    //   APNS_KEY_P8     contents of the AuthKey_XXXXXXXXXX.p8 file
    //   APNS_KEY_ID     that key's id
    // Without the two APNS secrets, pushes are decided and logged on
    // /registry/:org/stats (pushConfigured: false), not sent.
  },
  "observability": {
    "enabled": true
  }
}
